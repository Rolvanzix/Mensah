rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile: only the authenticated user can read and manage their own profile & practice data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Practice trading positions: strictly bound to the authenticated owner
      match /positions/{positionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
